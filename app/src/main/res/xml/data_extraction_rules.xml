<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Do not migrate an active lock or permission-prompt history onto a new device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
